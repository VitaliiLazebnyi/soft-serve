# vi: set ft=conf

# Test ssh imports by a caller whose key is listed in initial_admin_keys but
# who is not a database admin.
#
# Such a key is an admin for every other check, so with no
# ssh.client_allowed_hosts it may import from any ssh host. A mirror is
# synced later with its owner's stored privileges, so a non-admin account
# may not create an ssh mirror; an anonymous caller's mirror is owned by the
# default admin and may.

# first boot seeds the admin account with admin1's key only
exec soft serve &
ensureserverrunning SSH_PORT
# stopserver goes through the HTTP server, which may start after ssh
ensureserverrunning HTTP_PORT
stopserver
ensureservernotrunning SSH_PORT

# user1's key becomes an admin key, but no account holds it
env SOFT_SERVE_INITIAL_ADMIN_KEYS=$USER1_AUTHORIZED_KEY
exec soft serve &
ensureserverrunning SSH_PORT

# remotes that pass policy fail only at the clone, since nothing listens on
# loopback port 1
! usoft repo import anon1 ssh://git@127.0.0.1:1/x.git
stderr 'import failed'
! stderr 'unauthorized'
! usoft repo import anon2 --lfs-endpoint ssh://git@127.0.0.1:1/x.git ssh://git@127.0.0.1:1/x.git
stderr 'import failed'
! stderr 'unauthorized'
! usoft repo import --mirror anon3 ssh://git@127.0.0.1:1/x.git
stderr 'import failed'
! stderr 'unauthorized'

# give the key a non-admin account
soft user create user1 --key "$USER1_AUTHORIZED_KEY"

! usoft repo import user1 ssh://git@127.0.0.1:1/x.git
stderr 'import failed'
! stderr 'unauthorized'

# the mirror job could never sync this one, so it is refused up front
! usoft repo import --mirror user2 ssh://git@127.0.0.1:1/x.git
stderr 'unauthorized'
stderr 'owner is not an admin'
stderr 'make the owner an admin'
stderr 'also limits admins'
stderr 'import without --mirror'

# a plain import from a reachable ssh host succeeds: the server itself,
# reading a public repository with its own client key
soft repo create src
usoft repo import user3 ssh://git@127.0.0.1:$SSH_PORT/src
usoft repo mirror user3
stdout 'false'

# switching mirroring on later is refused for the same reason, and the flag
# is left alone
! usoft repo mirror user3 true
stderr 'unauthorized'
stderr 'owner is not an admin'
! stderr 'import without --mirror'
usoft repo mirror user3
stdout 'false'

soft repo list
! stdout 'anon'
! stdout 'user[12]'
stdout 'user3'

# stop the server
[windows] stopserver
[windows] ! stderr .
